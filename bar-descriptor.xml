<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>io.github.term50</id>
    <!-- Required bbnix userland (zsh/tmux/mosh/ssh + terminfo + CA bundle),
         staged into share/bbnix by `make stage-bbnix`, which package-dev and
         package-release run automatically. Provides the login shell (zsh) and
         the terminfo DB (Term50 exports TERMINFO at app/native/bbnix/terminfo). -->
    <asset path="share/bbnix">bbnix</asset>
    <asset path="share/fonts">fonts</asset>
    <asset path="share/NOTICE">NOTICE</asset>
    <asset path="share/LICENSE">LICENSE</asset>
    <asset path="share/README">README</asset>
    <asset path="share/README45">README45</asset>
    <asset path="share/term.lua.reference">term.lua.reference</asset>
    <asset path="share/AGENTS.md">AGENTS.md</asset>
    <asset path="share/icons/icon-86x86.png">icon-86x86.png</asset>
    <asset path="share/icons/icon-90x90.png">icon-90x90.png</asset>
    <asset path="share/icons/icon-96x96.png">icon-96x96.png</asset>
    <asset path="share/icons/icon-110x110.png">icon-110x110.png</asset>
    <asset path="share/icons/icon-144x144.png">icon-144x144.png</asset>

    <configuration name="Device-Debug">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="Device-Debug/Term50" entry="true" type="Qnx/Elf">Term50</asset>
       <asset path="Device-Debug/termctl" entry="false" type="Qnx/Elf">root/bin/termctl</asset>
       <asset path="Device-Debug/fen" entry="false" type="Qnx/Elf">root/bin/fen</asset>
    </configuration>
    <configuration name="Device-Release">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="Device-Release/Term50" entry="true" type="Qnx/Elf">Term50</asset>
       <asset path="Device-Release/termctl" entry="false" type="Qnx/Elf">root/bin/termctl</asset>
       <asset path="Device-Release/fen" entry="false" type="Qnx/Elf">root/bin/fen</asset>
    </configuration>

    <name>Term50</name>
    <versionNumber>1.1.0</versionNumber>
    <buildId>3</buildId>

    <!-- May have multiple values for each language. See samples or xsd schema file. -->
    <description>Term50 — a terminal emulator for BlackBerry 10</description>

    <!--  Must match the developer name of your developer certificate. -->
    <author>Term50 Developers</author>
    <!--  Unique author ID assigned by signing authority. Required if using debug tokens.
          Left commented so -devMode self-signing auto-derives a valid dev author-id. -->
    <!-- <authorId>Package-Author-Id</authorId> -->

    <initialWindow>
      <autoOrients>true</autoOrients>
      <systemChrome>none</systemChrome>
    </initialWindow>

    <icon>
      <image>icon-86x86.png</image>
      <image>icon-90x90.png</image>
      <image>icon-96x96.png</image>
      <image>icon-110x110.png</image>
      <image>icon-144x144.png</image>
    </icon>

    <!-- Request permission to execute native code.  Required for native applications. -->
    <permission system="true">run_native</permission>
    <permission>access_shared</permission>
    <permission>run_when_backgrounded</permission>
    <permission>bbm_connect</permission>
    <permission>access_pimdomain_calendars</permission>
    <permission>use_camera</permission>
    <permission>use_camera_desktop</permission>
    <permission>access_pimdomain_contacts</permission>
    <permission>read_device_identifying_information</permission>
    <permission>use_gamepad</permission>
    <permission>access_pimdomain_messages</permission>
    <permission>access_internet</permission>
    <permission>access_location_services</permission>
    <permission>record_audio</permission>
    <permission>read_personally_identifiable_information</permission>
    <permission>access_pimdomain_notebooks</permission>
    <permission>access_notify_settings_control</permission>
    <permission>access_phone</permission>
    <permission>read_phonecall_details</permission>
    <permission>access_pimdomain_calllogs</permission>
    <permission>control_phone</permission>
    <permission>post_notification</permission>
    <permission system="true">_sys_use_consumer_push</permission>
    <permission system="true">_sys_run_headless</permission>
    <permission system="true">_sys_headless_nostop</permission>
    <permission>access_sms_mms</permission>
    <permission>access_wifi_public</permission>


    <!-- Ensure that shared libraries in the package are found at run-time. -->
    <env var="LD_LIBRARY_PATH" value="app/native/lib"/>

    <!-- Opt-in: widen the control socket (~/.term/control.sock) from its private
         0600 default to the 1000_shared group so an out-of-sandbox peer in that
         group (a dev-mode ssh session) can drive Term50 headlessly via termctl.
         See src/control.c (ctl_shared_gid). SECURITY: any 1000_shared process can
         then drive the terminal; this is a dev/automation convenience. Remove
         this env for a locked-down build. -->
    <env var="TERM50_CONTROL_SHARED" value="1"/>

    <!-- Cross-app entry point (#23). Registers the term:// URI scheme so a
         tapped link, a homescreen shortcut, another app, or one of our own
         notifications can ask the navigator to open Term50. Navigation-only
         grammar (see README "Cross-app invoke"): term://tab[/N] opens or
         focuses a tab; term://focus just re-foregrounds. It deliberately
         cannot run commands; driving the shell is restricted to the in-sandbox
         control socket (#5). One-way, no reply. Being a URI handler needs no
         extra permission. -->
    <invoke-target id="io.github.term50">
        <type>APPLICATION</type>
        <filter>
            <action>bb.action.OPEN</action>
            <!-- The match is scoped by the term:// scheme below; mime-type
                 "*" is the documented form for a custom URI-scheme filter (a
                 URI-only open carries no concrete type), NOT a claim to handle
                 every content type. -->
            <mime-type>*</mime-type>
            <property var="uris" value="term://"/>
        </filter>
    </invoke-target>

</qnx>
