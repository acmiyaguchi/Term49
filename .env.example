# Device credentials for `make deploy` and `make connect`. Copy to .env (which
# is gitignored) and fill in. The Makefile soft-includes .env.
#
#   cp .env.example .env
#
# BBIP   target device IP (Development Mode). 169.254.0.1 is the USB default.
# BBPASS target device's Development Mode password.
#
# Note: BlackBerry's code-signing / BBID / debug-token servers are gone, so
# there is no keystore or debug-token generation here anymore. Dev-mode
# packaging self-signs; release bars are sideloaded unsigned (Sachesi/DBL).

BBIP   := 169.254.0.1
BBPASS := ""
